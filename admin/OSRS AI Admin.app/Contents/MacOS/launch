#!/bin/bash
# Launch script for OSRS AI Admin GUI

# Get the directory where the app bundle is located
APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
ADMIN_DIR="$(dirname "$APP_DIR")"
PROJECT_ROOT="$(dirname "$ADMIN_DIR")"

# Change to project root
cd "$PROJECT_ROOT"

# Set up PATH to include common Python locations
export PATH="/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:$HOME/.pyenv/shims:$PATH"

# Don't set PYTHONUSERBASE or PYTHONPATH - let Python find user site-packages naturally
# This avoids version conflicts between different Python installations

# Function to test if Python has PyQt6
test_python_pyqt6() {
    local python_cmd="$1"
    if command -v "$python_cmd" &> /dev/null; then
        # Get the actual Python executable path
        local actual_python=$("$python_cmd" -c "import sys; print(sys.executable)" 2>/dev/null)
        # Test if PyQt6 can be imported
        if "$python_cmd" -c "import PyQt6" 2>/dev/null; then
            echo "$python_cmd"
            return 0
        fi
    fi
    return 1
}

# Just use python3 - it should work from terminal
PYTHON_CMD="python3"

# Verify Python 3 is available
if ! command -v python3 &> /dev/null; then
    osascript -e 'display dialog "Python 3 is required but not found. Please install Python 3." buttons {"OK"} default button "OK" with icon stop'
    exit 1
fi

# Launch the GUI via wrapper script to avoid macOS security restrictions
exec "$ADMIN_DIR/launch_gui_wrapper.sh" 2>&1 | tee -a "$HOME/Library/Logs/OSRS-AI-Admin.log"
